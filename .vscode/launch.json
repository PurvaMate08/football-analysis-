{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/app.py"],
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: process video",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["process-video", "--video", "${workspaceFolder}/data/sample_videos/match.mp4"],
      "console": "integratedTerminal"
    }
  ]
}
